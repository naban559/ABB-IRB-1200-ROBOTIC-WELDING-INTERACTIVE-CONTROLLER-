<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="welding_workcell">
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugin systems for Ignition Gazebo / Gazebo Sim -->
    <plugin
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics">
    </plugin>
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands">
    </plugin>
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="ignition-gazebo-contact-system"
      name="ignition::gazebo::systems::Contact">
    </plugin>

    <!-- Workshop Ambient & Directional Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>2 1 4 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <light type="spot" name="welding_bay_spotlight">
      <cast_shadows>true</cast_shadows>
      <pose>0.6 0.0 2.2 0 0 0</pose>
      <diffuse>0.9 0.95 1.0 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>0 0 -1</direction>
      <spot>
        <inner_angle>0.6</inner_angle>
        <outer_angle>1.2</outer_angle>
        <falloff>1.0</falloff>
      </spot>
    </light>

    <!-- Workshop Concrete Floor -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.32 0.35 1</ambient>
            <diffuse>0.4 0.42 0.45 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Industrial Safety Enclosure Fence (Visual Representation) -->
    <model name="safety_enclosure">
      <static>true</static>
      <pose>0.4 0 0 0 0 0</pose>
      <link name="fence_links">
        <!-- Rear safety panel -->
        <visual name="rear_wall">
          <pose>-1.2 0 1.0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 3.0 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.18 0.18 0.20 0.8</ambient>
            <diffuse>0.25 0.25 0.28 0.8</diffuse>
          </material>
        </visual>
        <!-- Side safety panel left -->
        <visual name="side_wall_left">
          <pose>0.0 1.5 1.0 0 0 0</pose>
          <geometry>
            <box>
              <size>2.4 0.05 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.18 0.18 0.20 0.8</ambient>
            <diffuse>0.25 0.25 0.28 0.8</diffuse>
          </material>
        </visual>
        <!-- Side safety panel right -->
        <visual name="side_wall_right">
          <pose>0.0 -1.5 1.0 0 0 0</pose>
          <geometry>
            <box>
              <size>2.4 0.05 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.18 0.18 0.20 0.8</ambient>
            <diffuse>0.25 0.25 0.28 0.8</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

