<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="abb_irb1200_welding_workcell">

  <!-- Planning Groups -->
  <!-- 1. Primary Welding Arm group (controlling up to TCP) -->
  <group name="welding_arm">
    <chain base_link="base_link" tip_link="welding_torch_tcp" />
  </group>

  <!-- 2. Standard manipulator group (base_link to tool0) -->
  <group name="manipulator">
    <chain base_link="base_link" tip_link="tool0" />
  </group>

  <!-- Named Group States -->
  <group_state name="home" group="welding_arm">
    <joint name="joint_1" value="0.0" />
    <joint name="joint_2" value="0.0" />
    <joint name="joint_3" value="0.0" />
    <joint name="joint_4" value="0.0" />
    <joint name="joint_5" value="0.0" />
    <joint name="joint_6" value="0.0" />
  </group_state>

  <group_state name="ready" group="welding_arm">
    <joint name="joint_1" value="0.0" />
    <joint name="joint_2" value="0.25" />
    <joint name="joint_3" value="0.25" />
    <joint name="joint_4" value="0.0" />
    <joint name="joint_5" value="1.07" />
    <joint name="joint_6" value="0.0" />
  </group_state>

  <group_state name="pre_weld" group="welding_arm">
    <joint name="joint_1" value="0.0" />
    <joint name="joint_2" value="0.45" />
    <joint name="joint_3" value="0.35" />
    <joint name="joint_4" value="0.0" />
    <joint name="joint_5" value="0.77" />
    <joint name="joint_6" value="0.0" />
  </group_state>

  <!-- Virtual Joint connecting robot to world -->
  <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="world" />

  <!-- Robot internal collision pairs -->
  <disable_collisions link1="base_link" link2="link_1" reason="Adjacent" />
  <disable_collisions link1="link_1" link2="link_2" reason="Adjacent" />
  <disable_collisions link1="link_2" link2="link_3" reason="Adjacent" />
  <disable_collisions link1="link_2" link2="link_5" reason="Never" />
  <disable_collisions link1="link_2" link2="link_6" reason="Never" />
  <disable_collisions link1="link_3" link2="link_4" reason="Adjacent" />
  <disable_collisions link1="link_3" link2="link_5" reason="Never" />
  <disable_collisions link1="link_3" link2="link_6" reason="Never" />
  <disable_collisions link1="link_4" link2="link_5" reason="Adjacent" />
  <disable_collisions link1="link_5" link2="link_6" reason="Adjacent" />
  <disable_collisions link1="link_5" link2="flange" reason="Never" />
  <disable_collisions link1="link_6" link2="flange" reason="Adjacent" />
  <disable_collisions link1="flange" link2="tool0" reason="Adjacent" />

  <!-- Torch mounting and torch internal links collisions -->
  <disable_collisions link1="flange" link2="welding_torch_link" reason="Adjacent" />
  <disable_collisions link1="tool0" link2="welding_torch_link" reason="Adjacent" />
  <disable_collisions link1="link_6" link2="welding_torch_link" reason="Adjacent" />
  <disable_collisions link1="link_5" link2="welding_torch_link" reason="Never" />
  <disable_collisions link1="welding_torch_link" link2="torch_nozzle" reason="Adjacent" />
  <disable_collisions link1="welding_torch_link" link2="torch_wire_tip" reason="Adjacent" />
  <disable_collisions link1="torch_nozzle" link2="torch_wire_tip" reason="Adjacent" />

  <!-- Pedestal and floor collisions -->
  <disable_collisions link1="world" link2="workshop_floor" reason="Adjacent" />
  <disable_collisions link1="world" link2="robot_pedestal" reason="Adjacent" />
  <disable_collisions link1="workshop_floor" link2="robot_pedestal" reason="Adjacent" />
  <disable_collisions link1="robot_pedestal" link2="base_link" reason="Adjacent" />
  <disable_collisions link1="workshop_floor" link2="base_link" reason="Never" />
  <disable_collisions link1="robot_pedestal" link2="link_1" reason="Never" />
  <disable_collisions link1="workshop_floor" link2="link_1" reason="Never" />

  <!-- Table and workpiece collisions -->
  <disable_collisions link1="world" link2="welding_table_link" reason="Adjacent" />
  <disable_collisions link1="workshop_floor" link2="welding_table_link" reason="Adjacent" />
  <disable_collisions link1="welding_table_link" link2="workpiece_link" reason="Adjacent" />
  <disable_collisions link1="welding_table_link" link2="weld_seam_visual_straight" reason="Adjacent" />
  <disable_collisions link1="welding_table_link" link2="weld_seam_visual_transverse" reason="Adjacent" />
  <disable_collisions link1="workpiece_link" link2="weld_seam_visual_straight" reason="Adjacent" />
  <disable_collisions link1="workpiece_link" link2="weld_seam_visual_transverse" reason="Adjacent" />
  <disable_collisions link1="robot_pedestal" link2="welding_table_link" reason="Never" />

  <!-- Workpiece proximity clearance for torch tip -->
  <disable_collisions link1="torch_wire_tip" link2="workpiece_link" reason="User" />
  <disable_collisions link1="torch_wire_tip" link2="weld_seam_visual_straight" reason="User" />
  <disable_collisions link1="torch_wire_tip" link2="weld_seam_visual_transverse" reason="User" />

</robot>

